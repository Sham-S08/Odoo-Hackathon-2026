# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017//assetflow

# JWT
JWT_ACCESS_SECRET=replace_me_with_a_strong_secret
JWT_ACCESS_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Multer
# Allowed file types are enforced in code; this is just a placeholder.
UPLOAD_MAX_SIZE_MB=10

# AI Integration (FastAPI)
AI_MAINTENANCE_INSIGHTS_URL=http://127.0.0.1:8000/api/ai/maintenance-insights

# CORS
CORS_ORIGIN=http://localhost:3000

